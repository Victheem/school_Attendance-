# School Attendance & Workforce OS: Environment Configuration
# This system is 100% self-hostable with ZERO Supabase or SaaS subscription dependencies.

# Server Port (Default: 3000)
PORT=3000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# PostgreSQL Database Connection String
# Leave blank to run in embedded zero-config school server mode
# Or point to your self-hosted PostgreSQL instance:
DATABASE_URL=postgresql://attendance_user:change_password_here@localhost:5432/school_attendance_db

# Set to 'true' if connecting to an external cloud PostgreSQL with SSL
DATABASE_SSL=false

# JSON Web Token Secret for Role-Based Access Control
JWT_SECRET=replace_with_a_secure_random_64_character_secret_string

# Allowed CORS Origin for production API calls
CORS_ORIGIN=http://localhost:3000

# School Multi-Tenancy Identifier
SCHOOL_ID=RCIS

# AI Studio Optional Runtime Configuration
GEMINI_API_KEY=
APP_URL=http://localhost:3000
